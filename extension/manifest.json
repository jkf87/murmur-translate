{
  "manifest_version": 3,
  "name": "Murmur 로컬 번역",
  "version": "0.1.0",
  "description": "murmur(NLLB-200) 로컬 번역 서버로 웹페이지와 유튜브 자막을 이중 언어로 보여 주는 실습용 확장",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "http://127.0.0.1:8790/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Murmur 로컬 번역",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/youtube-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/youtube.js"
      ],
      "css": [
        "content/style.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content/page.js",
        "content/float.js"
      ],
      "css": [
        "content/style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}